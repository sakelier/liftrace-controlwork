<launch>
  <arg name="image_topic" default="/downward_camera/image_raw" />
  <arg name="camera_info_topic" default="/downward_camera/camera_info" />
  <arg name="target_model_path" default="$(optenv UAV_VISION_MODEL_PATH)" />
  <!-- target_detector.py 依赖 rl_drone 环境里的 ultralytics；用 launch-prefix 让节点
       以该 conda python 执行，而不是 devel wrapper 默认的系统 python3。 -->
  <arg name="target_detector_launch_prefix" default="$(optenv VISION_PYTHON /root/miniconda/envs/rl_drone/bin/python)" />
  <arg name="map_frame" default="camera_init" />
  <arg name="ground_z" default="0.0" />
  <arg name="enable_debug_image" default="false" />
  <arg name="default_align_mode" default="disabled" />
  <arg name="drop_stable_frames" default="3" />
  <arg name="allow_latest_tf_fallback" default="false" />
  <arg name="max_latest_tf_age_sec" default="0.10" />

  <node pkg="uav_vision" type="pose_tf_broadcaster.py"
        name="vision_pose_tf" output="screen">
    <param name="pose_topic" value="/mavros/local_position/pose" />
    <param name="parent_frame" value="camera_init" />
    <param name="child_frame" value="vision_body" />
  </node>

  <node pkg="tf2_ros" type="static_transform_publisher"
        name="downward_camera_extrinsic"
        args="0 0 -0.05 -0.70710678 0.70710678 0 0 vision_body downward_camera_optical_frame" />

  <include file="$(find uav_vision)/launch/phase_d.launch">
    <arg name="image_topic" value="$(arg image_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="target_model_path" value="$(arg target_model_path)" />
    <arg name="target_detector_launch_prefix" value="$(arg target_detector_launch_prefix)" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="ground_z" value="$(arg ground_z)" />
    <arg name="enable_debug_image" value="$(arg enable_debug_image)" />
    <arg name="default_align_mode" value="$(arg default_align_mode)" />
    <arg name="drop_stable_frames" value="$(arg drop_stable_frames)" />
    <arg name="allow_latest_tf_fallback" value="$(arg allow_latest_tf_fallback)" />
    <arg name="max_latest_tf_age_sec" value="$(arg max_latest_tf_age_sec)" />
    <arg name="start_legacy_compat" value="false" />
  </include>
</launch>
